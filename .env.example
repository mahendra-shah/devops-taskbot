# ============================================================
#  DevOps Tracker Bot — Environment Configuration
# ============================================================

# ----- Slack -----
# Bot token (xoxb-...) from your Slack App OAuth page
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-...) for Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# Channel ID of your devops Slack channel (e.g. C012AB3CD)
# Right-click the channel in Slack → Copy link → last segment is the ID
SLACK_DEVOPS_CHANNEL_ID=C0XXXXXXXXX

# ----- GitHub -----
# Personal Access Token or GitHub App token with repo + issues scope
GITHUB_TOKEN=ghp_your_github_token

# Your GitHub org or username
GITHUB_OWNER=your-org

# The GitHub repo dedicated to DevOps issue tracking (no code, just issues)
GITHUB_REPO=devops-tasks

# ----- LLM (Gemini or DeepSeek — configure one or both for failover) -----
# Options: "gemini" | "deepseek"
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# ----- Team Members -----
# Comma-separated list of Slack_User_ID:GitHub_Username pairs
# To find Slack user IDs: Profile → More → Copy member ID
TEAM_MEMBERS=U12345678:mahendra-gh,U87654321:ravi-gh,U11223344:priya-gh

# ----- Bot Behavior -----
# How many minutes of silence before the bot auto-replies with workload status
NO_REPLY_TIMEOUT_MINUTES=90

# Hours an issue can stay open before SLA breach alert is fired
SLA_BREACH_HOURS=24

# Cron expression for daily digest (default: 9:30 AM Mon-Fri)
DAILY_DIGEST_CRON=30 9 * * 1-5

# Set to "true" to show LLM/token debug metadata in Slack replies
SHOW_DEV_METADATA=false

# ----- Out-of-office detection (reads each dev's Slack status, display name and full name) -----
# Needs the Slack scope `users:read` and the bot event `user_change`.
# Timezone used if Slack doesn't report one for a person (minutes east of UTC; 330 = IST)
DEFAULT_TZ_OFFSET_MINUTES=330
# Extra words that should count as "out of office" (comma-separated), on top of the built-ins
# (OOO, on leave, vacation, holiday, PTO, sick, 🌴 …)
# OOO_EXTRA_KEYWORDS=wfh-off,offline today

# ----- P0 escalation -----
# Minutes after a P0 is created at which an un-acknowledged P0 escalates (level 1, 2, 3)
ESCALATION_MINUTES=30,60,120

# ----- Repeat-request detection -----
# Same kind of request this many times within the window → one note to the devops channel
REPEAT_REQUEST_THRESHOLD=3
REPEAT_REQUEST_WINDOW_DAYS=30

# ----- Persistence -----
# SQLite file for timers, thread links, audit log, etc. (default: ./data/devops-tracker.db)
# STATE_DB_PATH=./data/devops-tracker.db

# ----- Weekly report by EMAIL (nodemailer / SMTP) -----
# Leave SMTP_HOST empty to disable. Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_FROM=
REPORT_TO=lead@example.com,team@example.com
# Friday 18:00 in REPORT_TIMEZONE
WEEKLY_REPORT_CRON=0 18 * * 5
REPORT_TIMEZONE=Asia/Kolkata
